{
  "name": "catalogy-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend-for-frontend for the Catalogy product catalogue PoC",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--use-system-ca tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --use-system-ca --env-file-if-exists=.env dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "nodemailer": "^6.10.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
