# Copy to .env and adjust. Never commit .env.

PORT=3000

# Upstream product data source (swap the adapter in src/products to change provider)
FAKE_STORE_BASE_URL=https://fakestoreapi.com
# How long upstream product data is cached in memory (seconds)
PRODUCT_CACHE_TTL_SECONDS=300

# Merchandiser-chosen "top rated" products for the home page (comma separated ids).
# Leave empty to fall back to the 5 highest-rated products.
FEATURED_PRODUCT_IDS=1,4,9,13,18
# Number of "top rated" products shown at the top of a category page
CATEGORY_TOP_RATED_COUNT=3

# Enquiry email. "smtp" or "console" (console just logs the email; handy without Docker)
EMAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SALES_INBOX=sales@catalogy.local
EMAIL_FROM=Catalogy <no-reply@catalogy.local>
